{
	"name": "forvoyez-documentation",
	"version": "1.0.0",
	"private": false,
	"scripts": {
		"dev": "next dev --webpack -H 0.0.0.0",
		"build": "next build --webpack",
		"start": "next start",
		"prettier": "prettier --write .",
		"precommit": "lint-staged",
		"prepare": "husky",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"lint-staged": {
		"*.js": [
			"prettier --write",
			"eslint --fix"
		],
		"*.json": "prettier --write",
		"*.css": "prettier --write"
	},
	"browserslist": "defaults, not ie <= 11",
	"dependencies": {
		"@algolia/autocomplete-core": "1.19.12",
		"@headlessui/react": "2.2.10",
		"@headlessui/tailwindcss": "0.2.2",
		"@mdx-js/loader": "3.1.1",
		"@mdx-js/react": "3.1.1",
		"@next/mdx": "16.4.0",
		"@sindresorhus/slugify": "3.0.1",
		"@tailwindcss/postcss": "4.3.3",
		"acorn": "8.19.0",
		"clsx": "2.1.1",
		"fast-glob": "3.3.3",
		"flexsearch": "0.8.212",
		"mdast-util-to-string": "4.0.0",
		"mdx-annotations": "0.1.4",
		"motion": "14.0.0",
		"next": "16.4.0",
		"next-themes": "0.4.6",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"react-highlight-words": "0.21.0",
		"remark": "15.0.1",
		"remark-gfm": "4.0.1",
		"remark-mdx": "3.1.1",
		"shiki": "4.5.0",
		"simple-functional-loader": "1.2.1",
		"tailwindcss": "4.3.3",
		"unist-util-filter": "5.0.1",
		"unist-util-visit": "5.1.0",
		"zustand": "5.0.15"
	},
	"devDependencies": {
		"@eslint/compat": "2.1.1",
		"eslint": "10.12.0",
		"eslint-config-next": "16.4.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-no-only-tests": "3.4.0",
		"eslint-plugin-prettier": "5.5.6",
		"husky": "9.1.7",
		"lint-staged": "17.6.0",
		"postcss": "8.5.29",
		"prettier": "3.9.9",
		"prettier-plugin-tailwindcss": "0.8.1",
		"sharp": "0.35.5"
	},
	"packageManager": "pnpm@10.34.6"
}
